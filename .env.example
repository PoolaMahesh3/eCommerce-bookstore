# Copy to .env (git-ignored) or inject from Vault / IBM Key Protect. Never commit real values.
# Generate local development secrets with:  npm run gen-env > .env
HOST=127.0.0.1
PORT=8080
DB_PATH=bookstore.db

# Built-in auth (development). Min 32 chars.
JWT_SECRET=
# Payment-provider webhook HMAC secret. Min 32 chars.
WEBHOOK_SECRET=
# 32 random bytes, base64 (AES-256-GCM for PII at rest):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=

# Production auth: OpenID Connect. When set, the built-in login is disabled and JWT_SECRET is not needed.
# OIDC_ISSUER=https://idp.example.com/realms/books
# OIDC_AUDIENCE=bookstore-api
# OIDC_JWKS_URL=https://idp.example.com/realms/books/protocol/openid-connect/certs
# OIDC_ROLE_CLAIM=roles

# Optional bootstrap admin (built-in auth only; password >= 12 chars)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional tuning
# RESERVATION_TTL_SEC=900
# RATE_LIMIT_PER_MIN=300
# AUTH_RATE_LIMIT_PER_MIN=10
# TRUST_PROXY=false
# TLS_CERT_FILE=
# TLS_KEY_FILE=
